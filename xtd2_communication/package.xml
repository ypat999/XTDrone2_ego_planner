<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>xtd2_communication</name>
  <version>0.0.0</version>
  <description>XTDrone2 communication package with C++ coordinate transform utilities</description>
  <maintainer email="zhuoan@stu.pku.edu.cn">andy-station-ubuntu-24</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  
  <depend>eigen</depend>
  <depend>libeigen3-dev</depend>
  
  <build_depend>pybind11-dev</build_depend>
  
  <exec_depend>tf_transformations</exec_depend>
  <exec_depend>px4_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
