[Unit]
Description=fastlio Service
After=network.target
Wants=network.target

[Service]
Type=simple
User=cat
Group=cat
WorkingDirectory=/home/cat/git/xtd2_ws
# Environment="ROS_DOMAIN_ID=27"
ExecStart=/home/cat/git/xtd2_ws/XTDrone2_ego_planner/lio/scripts/run_lidar_localization.sh
# ExecStop=/home/cat/git/xtd2_ws/XTDrone2_ego_planner/lio/scripts/stop_all_navs.sh
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target