<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='x500_depth'>
    <include merge='true'>
      <uri>x500</uri>
    </include>
    <include merge='true'>
      <uri>model://OakD-Lite</uri>
      <!-- <pose>.12 .03 .242 0 0 0</pose> -->
      <pose>-.24 -.03 .242 0 0 3.14</pose>
    </include>
    <joint name="CameraJoint" type="fixed">
      <parent>base_link</parent>
      <child>OakD-Lite/base_link</child>
      <pose relative_to="base_link">-.24 -.03 .242 0 0 3.14</pose>
      <!-- <pose relative_to="base_link">.12 .03 .242 0 -1.57 0</pose> -->
    </joint>
    
    <!-- Mid360 Livox -->
    <link name="livox_frame">
      <pose>0.1 0 0.30 0 0.5236 0.0</pose>
      <inertial>
        <mass>0.2</mass>
        <pose>0 0 0 0 0 0</pose>
        <inertia>
          <ixx>0.0004</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0004</iyy>
          <iyz>0</iyz>
          <izz>0.0004</izz>
        </inertia>
      </inertial>
      <gravity>true</gravity>
      <visual name="livox_frame_visual">
        <geometry>
          <mesh>
            <uri>meshes/mid-360-scaled.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="livox_frame_collision">
        <geometry>
          <mesh>
            <uri>meshes/mid-360-scaled.dae</uri>
          </mesh>
        </geometry>
      </collision>

      <sensor name="mid360_lidar" type="gpu_lidar">
        <topic>livox/lidar</topic>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.1415926</min_angle>
              <max_angle>3.1415926</max_angle>
            </horizontal>
            <vertical>
              <samples>60</samples>
              <resolution>1</resolution>
              <min_angle>-0.126012</min_angle>
              <max_angle>0.963771</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.5</min>
            <max>100.0</max>
            <resolution>0.005</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.002</stddev>
          </noise>
        </ray>
      </sensor>

      <sensor name="mid360_imu" type="imu">
        <topic>livox/imu</topic>
        <update_rate>50</update_rate>
        <always_on>true</always_on>
        <imu>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.017</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.017</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.017</stddev>
              </noise>
            </z>
          </linear_acceleration>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>2e-4</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>2e-4</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>2e-4</stddev>
              </noise>
            </z>
          </angular_velocity>

        </imu>
      </sensor>
    </link>
    
    <joint name="livox_frame_joint" type="fixed">
      <parent>base_link</parent>
      <child>livox_frame</child>
    </joint>
    
    <!-- Mid360 Down Livox -->
    <link name="livox_down_frame">
      <pose>0.1 0 0.20 0 2.618 0.0</pose>
      <inertial>
        <mass>0.2</mass>
        <pose>0 0 0 0 0 0</pose>
        <inertia>
          <ixx>0.0004</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0004</iyy>
          <iyz>0</iyz>
          <izz>0.0004</izz>
        </inertia>
      </inertial>
      <gravity>true</gravity>
      <visual name="livox_down_frame_visual">
        <geometry>
          <mesh>
            <uri>meshes/mid-360-scaled.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="livox_down_frame_collision">
        <geometry>
          <mesh>
            <uri>meshes/mid-360-scaled.dae</uri>
          </mesh>
        </geometry>
      </collision>

      <sensor name="mid360_down_lidar" type="gpu_lidar">
        <topic>livox_down/lidar</topic>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.1415926</min_angle>
              <max_angle>3.1415926</max_angle>
            </horizontal>
            <vertical>
              <samples>60</samples>
              <resolution>1</resolution>
              <min_angle>-0.126012</min_angle>
              <max_angle>0.963771</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.5</min>
            <max>100.0</max>
            <resolution>0.005</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.002</stddev>
          </noise>
        </ray>
      </sensor>

      <sensor name="mid360_down_imu" type="imu">
        <topic>livox_down/imu</topic>
        <update_rate>50</update_rate>
        <always_on>true</always_on>
        <imu>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.017</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.017</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.017</stddev>
              </noise>
            </z>
          </linear_acceleration>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>2e-4</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>2e-4</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>2e-4</stddev>
              </noise>
            </z>
          </angular_velocity>

        </imu>
      </sensor>
    </link>
    
    <joint name="livox_down_frame_joint" type="fixed">
      <parent>base_link</parent>
      <child>livox_down_frame</child>
    </joint>
  </model>
</sdf>
