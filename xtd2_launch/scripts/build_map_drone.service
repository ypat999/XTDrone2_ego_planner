[Unit]
Description=XTDrone2 Single Vehicle Demo Service
After=network.target
Wants=network.target

[Service]
Type=simple
User=cat
Group=cat
WorkingDirectory=/home/cat/git/xtd2_ws
Environment="ROS_DOMAIN_ID=0"
Environment="BUILD_MAP=true"
ExecStart=/home/cat/git/xtd2_ws/XTDrone2_ego_planner/xtd2_launch/scripts/start_single_vehicle_demo.sh
ExecStop=/home/cat/git/xtd2_ws/XTDrone2_ego_planner/xtd2_launch/scripts/stop_single_vehicle_demo.sh
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
